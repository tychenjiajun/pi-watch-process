{
  "name": "pi-watch-process",
  "version": "1.1.1",
  "type": "module",
  "description": "Pi extension to manage CLI watch-mode processes (tsc --watch, jest --watch, etc.)",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "watch",
    "build-watcher",
    "tsc",
    "jest"
  ],
  "license": "MIT",
  "files": [
    "*.ts",
    "src/",
    "docs/",
    "README.md",
    "README_zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "typescript": "^7.0.2",
    "typebox": "^1.4.5"
  }
}
